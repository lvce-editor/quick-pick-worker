{
  "name": "@lvce-editor/quick-pick-worker",
  "version": "0.0.0-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvce-editor/quick-pick-worker.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "src/quickPickWorkerMain.ts",
  "scripts": {
    "dev": "cd ../../ && npm run dev",
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@lvce-editor/assert": "^1.7.0",
    "@lvce-editor/constants": "^5.20.0",
    "@lvce-editor/fuzzy-search": "^2.4.0",
    "@lvce-editor/i18n": "^2.5.0",
    "@lvce-editor/list": "^1.12.0",
    "@lvce-editor/rpc": "^6.10.0",
    "@lvce-editor/rpc-registry": "^9.39.0",
    "@lvce-editor/viewlet-registry": "^5.5.0",
    "@lvce-editor/virtual-dom-worker": "^11.9.0",
    "@types/node": "^25.6.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12"
  }
}
